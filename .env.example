# =========================================
# CVGen - Variables d'environnement (exemple)
# Copier ce fichier en .env et compléter
# =========================================

# --- Base de données (côté backend, hôte = nom du service Docker) ---
DB_URL=jdbc:postgresql://postgres:5432/cvgen
DB_USERNAME=cvgen_user
DB_PASSWORD=cvgen_password
DB_NAME=cvgen

# --- PostgreSQL (init du conteneur) ---
POSTGRES_USER=cvgen_user
POSTGRES_PASSWORD=cvgen_password

# --- JWT / Auth ---
JWT_SECRET=change_me_in_production_min_32_chars
