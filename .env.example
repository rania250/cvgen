# =========================================
# CVGen - Variables d'environnement (exemple)
# Copier ce fichier en .env et compléter
# =========================================

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=cvgen
POSTGRES_USER=cvgen
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/cvgen

# --- JWT / Auth ---
JWT_SECRET=changeme-please-use-a-strong-secret
JWT_EXPIRATION_MS=86400000

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cvgen-files

# --- Fournisseur LLM (génération) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=CVGen
